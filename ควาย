floatStroke.Thickness = 2
floatStroke.Parent = floatingBtn

-- ระบบลากปุ่มวงกลม
local draggingFloat = false
local dragStartFloat, startPosFloat
local hasMoved = false

floatingBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingFloat = true
        dragStartFloat = input.Position
        startPosFloat = floatingBtn.Position
        hasMoved = false
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingFloat = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingFloat and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartFloat
        if delta.Magnitude > 5 then
            hasMoved = true
        end
        floatingBtn.Position = UDim2.new(startPosFloat.X.Scale, startPosFloat.X.Offset + delta.X, startPosFloat.Y.Scale, startPosFloat.Y.Offset + delta.Y)
    end
end)

-- พอกดคลิกปุ่มวงกลม (ถ้าไม่ได้ลาก) ให้เปิดหน้าต่างหลัก
floatingBtn.MouseButton1Click:Connect(function()
    if not hasMoved then
        frame.Visible = true
        floatingBtn.Visible = false
    end
end)

-- พอกดปุ่มย่อ (–) ให้ซ่อนหน้าต่างหลักแล้วแสดงปุ่มวงกลม
minimizeBtn.MouseButton1Click:Connect(function()
    frame.Visible = false
    floatingBtn.Visible = true
end)

closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- ==========================================
-- 5. ระบบการทำงาน FPS Boost
-- ==========================================
local isFpsBoostEnabled = false

toggleBtn.MouseButton1Click:Connect(function()
    isFpsBoostEnabled = not isFpsBoostEnabled
    if isFpsBoostEnabled then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 215, 75)
        toggleBtn.Text = "● บูสต์ FPS: เปิดใช้งาน"
        
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 999999
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("PostEffect") or v:IsA("Clouds") then
                v.Parent = nil
            end
        end
        
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                v.Enabled = false
            end
        end
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        toggleBtn.Text = "● บูสต์ FPS: ปิดใช้งาน"
        
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("PostEffect") or v:IsA("Clouds") then
                v.Parent = Lighting
            end
        end
        
        player:LoadCharacter()
    end
end)
